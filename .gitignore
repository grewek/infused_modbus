/target
# server-no-std is its own standalone workspace (see its Cargo.toml) with
# its own target/ directory, not covered by the root /target entry above.
/server-no-std/target

# Generated TLS identities (self-signed cert + private key) — never commit
# generated key material, even throwaway/test-generated.
/server-tls-identity/
/client-tls-identity/

# Persisted Sparkplug B bdSeq counter (client::bd_seq_persistence) — runtime
# state, not source; defaults to the current working directory.
/client-mqtt-bdseq
