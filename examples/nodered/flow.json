        "info": "Edit GROUP_ID/EDGE_NODE_ID/DEVICE_ID to match your running `client` and target machine.",
        "func": "const GROUP_ID = \"NodeRedTest\";\nconst EDGE_NODE_ID = \"ClaudeClient\";\nconst DEVICE_ID = \"PumpA\";\n\nmsg.topic = `spBv1.0/${GROUP_ID}/DCMD/${EDGE_NODE_ID}/${DEVICE_ID}`;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 430,
        "y": 520,
        "wires": [
