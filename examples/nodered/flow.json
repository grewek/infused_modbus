    {
        "id": "rd-split",
        "type": "function",
        "z": "rd-tab",
        "name": "split metrics by name",
        "info": "One output per known point - only fires an output when that specific metric is present in this message (DBIRTH carries all of them once; DDATA only carries what changed).",
        "func": "const metrics = (msg.payload && msg.payload.metrics) || [];\nconst byName = {};\nfor (const m of metrics) {\n    byName[m.name] = m.value;\n}\nconst order = [\n    \"Door_Position\",\n    \"Motor_Running\",\n    \"Fully_Open\",\n    \"Fully_Closed\",\n    \"Emergency_Stop\",\n    \"Light_Barrier\"\n];\nreturn order.map((name) =>\n    Object.prototype.hasOwnProperty.call(byName, name) ? { payload: byName[name] } : null\n);",
        "outputs": 6,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 460,
        "y": 160,
        "wires": [
